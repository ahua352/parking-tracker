{
	"cli": {
		"version": ">= 16.7.0",
		"appVersionSource": "remote",
		"requireCommit": true
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"env": {
				"GOOGLE_MAPS_API_KEY": "$GOOGLE_MAPS_API_KEY"
			}
		},
		"preview": {
			"distribution": "internal",
			"env": {
				"GOOGLE_MAPS_API_KEY": "$GOOGLE_MAPS_API_KEY"
			}
		},
		"production": {
			"autoIncrement": true,
			"env": {
				"GOOGLE_MAPS_API_KEY": "$GOOGLE_MAPS_API_KEY"
			}
		}
	},
	"submit": {
		"production": {}
	}
}
